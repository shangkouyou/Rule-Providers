# ============================================================
# 21Proxy 规则集
# 用途：命中后走 config.yaml 中的「21Proxy」策略组
# 维护：直接编辑本文件；mihomo 按 interval 自动拉取
# 注意：本规则集在 rules 中位于 ProxyGFWlist 之前，命中即生效
# 注意：行尾注释不会被解析，注释必须独立成行
# ============================================================

# --- 交易所 ---
# OKX / 欧易（OE）：主站、APP API、Web3 浏览器
DOMAIN-SUFFIX,okx.com
DOMAIN-SUFFIX,okex.com
DOMAIN-SUFFIX,oklink.com
DOMAIN-SUFFIX,okx.cab
DOMAIN-KEYWORD,htx
DOMAIN-KEYWORD,bybit
DOMAIN-KEYWORD,pionex
DOMAIN,binance.com

# --- 券商 / 行情 ---
DOMAIN-KEYWORD,trading212
DOMAIN-KEYWORD,moomoo
DOMAIN-KEYWORD,longbridge
DOMAIN-KEYWORD,itiger

# --- 支付 ---
DOMAIN-KEYWORD,oyunfor
DOMAIN-KEYWORD,iyzico
DOMAIN-KEYWORD,paymaya

# --- 语音 / 通信 ---
DOMAIN-KEYWORD,voice
DOMAIN-KEYWORD,telephony
DOMAIN,voice.telephony.goog

# --- AI 服务 ---
DOMAIN-KEYWORD,manus
DOMAIN-KEYWORD,copilot
DOMAIN-KEYWORD,gamma
DOMAIN-KEYWORD,lovart
DOMAIN-KEYWORD,grok
DOMAIN-KEYWORD,grokipedia
DOMAIN-SUFFIX,muse.ai
DOMAIN-SUFFIX,meta.ai
DOMAIN-SUFFIX,metaaivm.com

# --- Dola AI（字节跳动海外豆包）---
# 说明：dola.com 与 ciciai.com / cici.com 同属字节跳动 AI 助手体系；
#       ciciai.com / cici.com 也在 ProxyGFWlist 中出现，由本规则抢先接管。
#       ibytedapm.com 在 ChinaDomain 中被判为直连，实际不可达，这里改为代理。
#       byteoversea.com 通常已被 TikTok 规则集先命中，此处作为兜底保留。
DOMAIN-SUFFIX,dola.com
DOMAIN-SUFFIX,ciciai.com
DOMAIN-SUFFIX,cici.com
DOMAIN-SUFFIX,bytedapm.com
DOMAIN-SUFFIX,ibytedapm.com
DOMAIN-SUFFIX,byteoversea.com

# --- 流媒体 ---
DOMAIN-KEYWORD,emotn
DOMAIN-KEYWORD,tubi
DOMAIN-KEYWORD,crunchyroll
DOMAIN-KEYWORD,max
DOMAIN-KEYWORD,hbomax
DOMAIN-KEYWORD,hbo
DOMAIN-KEYWORD,hbonow
DOMAIN-KEYWORD,hbogo
DOMAIN-KEYWORD,discomax
DOMAIN-KEYWORD,netshort
DOMAIN-SUFFIX,netshort.tv
DOMAIN-KEYWORD,reelshort
DOMAIN-KEYWORD,shortmax
DOMAIN-KEYWORD,dramabox
DOMAIN-KEYWORD,topshort

# --- Meta 全家桶 ---
# 说明：muse.ai 未被其他 ruleset 命中，会落到 MATCH→漏网之鱼(DIRECT) 而超时；
#       meta.com / facebook.com / fbcdn.net 在 ProxyGFWlist 命中，
#       这里统一收敛到 21Proxy 组，保证同一会话出口 IP 一致。
#       不要用 DOMAIN-KEYWORD,muse —— muse.com / muse.io / museapp.com 是无关站点。
DOMAIN-SUFFIX,meta.com
DOMAIN-SUFFIX,facebook.com
DOMAIN-SUFFIX,fbcdn.net
DOMAIN-SUFFIX,fbsbx.com
DOMAIN-SUFFIX,messenger.com
DOMAIN-SUFFIX,oculus.com
DOMAIN-SUFFIX,threads.com
DOMAIN-SUFFIX,threads.net
DOMAIN-SUFFIX,cdninstagram.com
DOMAIN-SUFFIX,instagram.com
DOMAIN-SUFFIX,whatsapp.com
DOMAIN-SUFFIX,whatsapp.net

# --- 其他 ---
DOMAIN,c.gle
DOMAIN-SUFFIX,b.ai
DOMAIN-KEYWORD,poshmark
DOMAIN-KEYWORD,mercari
DOMAIN-KEYWORD,swag
DOMAIN-KEYWORD,revvitysignals

