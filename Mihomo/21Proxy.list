# ============================================================
# 21Proxy 规则集
# 用途：命中后走 config.yaml 中的「21Proxy」策略组
# 维护：直接编辑本文件；mihomo 按 interval 自动拉取
# 注意：本规则集在 rules 中位于 ProxyGFWlist 之前，命中即生效
# 注意：行尾注释不会被解析，注释必须独立成行
# ============================================================

# --- 交易所 ---
# OKX / 欧易（OE）：主站、APP API、Web3 浏览器
DOMAIN-SUFFIX,okx.com
DOMAIN-SUFFIX,okex.com
DOMAIN-SUFFIX,oklink.com
DOMAIN-SUFFIX,okx.cab
DOMAIN-KEYWORD,htx
DOMAIN-KEYWORD,bybit
DOMAIN-KEYWORD,pionex
DOMAIN,binance.com

# --- GMGN.AI（多链 Meme 交易终端：Solana / BNB / ETH / Base / TRON / Monad）---
# 说明：主站与全部子域同属一家，DOMAIN-SUFFIX,gmgn.ai 一条即覆盖下面所有子域，
#       此处列出仅为说明，不要再为子域重复写规则：
#       - gmgn.ai / www / api  主站与接口（接口路径 /api/v1、/defi/quotation）
#       - ws.gmgn.ai           行情与订单 WebSocket 长连接，断开后 K 线和余额不刷新
#       - sub-tx-hash.gmgn.ai  交易哈希上报，不通会一直 pending、下单不落地
#       - link.gmgn.ai         邀请返佣短链，走 Cloudflare
#       - docs.gmgn.ai         帮助文档，走 CloudFront
#       - memecoin.gmgn.ai     活动落地页，走 CloudFront
#       下面这些第三方域名是网页实测会请求的依赖，缺任一个就会白屏、
#       登录过不了人机验证或连不上钱包，故一并收敛到本组，保证同一会话出口 IP 一致：
#       - beta.helius-rpc.com        Solana RPC：余额、报价、模拟交易
#       - pulse.walletconnect.org    WalletConnect 会话状态
#       - api.web3modal.org          WalletConnect / Web3Modal 钱包连接
#       - challenges.cloudflare.com  Cloudflare Turnstile 人机验证（登录、领空投）
#       - static.four.meme           Four.meme（BSC 发射台）代币图标与静态资源
#       - js.intercomcdn.com / api-iam.intercom.io / nexus-websocket-a.intercom.io
#                                    Intercom 在线客服组件
DOMAIN-SUFFIX,gmgn.ai
DOMAIN-SUFFIX,helius-rpc.com
DOMAIN-SUFFIX,walletconnect.org
DOMAIN-SUFFIX,walletconnect.com
DOMAIN-SUFFIX,web3modal.org
DOMAIN-SUFFIX,four.meme
DOMAIN-SUFFIX,intercomcdn.com
DOMAIN-SUFFIX,intercom.io
DOMAIN-SUFFIX,challenges.cloudflare.com

# --- FOMO（fomo.family，社交型多链 Meme 交易，FOMO Labs Inc.）---
# 说明：fomo.family 是唯一主域，全部接口和子域都归下面这一条，不要再为子域重复写规则：
#       - fomo.family / www            主站与网页版交易（/trade、/markets）
#       - prod-api / prod-us-api / prod-apac-api / prod-euc-api / prod-external-api
#                                      按区域拆分的 API 入口
#       - prod-edge / evm-data.prod-edge  行情与链上数据的自建边缘节点
#       - app-actions / app-actions3    PostHog 埋点，他们反代到自己域上
#       - auth / privy / feature-flags  登录、Privy 托管钱包、特性开关
#       - banner / download / status / wrapped-2025 / newsletter / legacy-landing
#       - preview / preprod / staging-edge / staging-orders / admin-staging  预发环境
#       fomo.com 提供的是同一份站点（除随机 CSP nonce 外 HTML 完全相同，
#       canonical 指向 fomo.family，同一 Cloudflare 账号），属同一家，一并收敛。
DOMAIN-SUFFIX,fomo.family
DOMAIN-SUFFIX,fomo.com

# --- FOMO 兜底依赖（链 RPC + 特性开关）---
# 说明：主站把链上读取走 prod-edge 自建中转，平时不会直连这些；
#       它们写死在前端 viem 链配置与 Statsig SDK 里，只在中转故障时兜底命中，
#       留着可以避免此时页面一直转圈。嫌多可以整段删掉，不影响主流程。
#       - rpc.monad.xyz / rpc1.monad.xyz            Monad RPC
#       - 56.rpc.thirdweb.com                        BSC RPC（thirdweb 中转）
#       - mainnet.base.org                           Base RPC
#       - eth.merkle.io                              ETH RPC
#       - rpc.mainnet.chain.robinhood.com            Robinhood Chain RPC
#       - statsigapi.net / statsigcdn.com / featureassets.org / prodregistryv2.org
#                                                    Statsig 特性开关
DOMAIN-SUFFIX,monad.xyz
DOMAIN-SUFFIX,thirdweb.com
DOMAIN,mainnet.base.org
DOMAIN,eth.merkle.io
DOMAIN,rpc.mainnet.chain.robinhood.com
DOMAIN-SUFFIX,statsigapi.net
DOMAIN-SUFFIX,statsigcdn.com
DOMAIN-SUFFIX,featureassets.org
DOMAIN-SUFFIX,prodregistryv2.org

